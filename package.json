{
  "name": "n8n-nodes-desearch",
  "version": "0.1.1",
  "description": "AI search, X search and web search for AI agents.",
  "license": "MIT",
  "homepage": "https://github.com/Desearch-ai/n8n-nodes-desearch",
  "keywords": [
    "n8n-community-node-package",
    "desearch",
    "search",
    "x-search",
    "web-search"
  ],
  "author": {
    "name": "Desearch AI",
    "email": "support@desearch.ai"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Desearch-ai/n8n-nodes-desearch.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/DesearchApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Desearch/Desearch.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^21.1.0",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
