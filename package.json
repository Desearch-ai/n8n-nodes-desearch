{
  "name": "n8n-nodes-desearch",
  "version": "0.5.0",
  "description": "AI search, web search, X, TikTok, Facebook, Instagram, YouTube, Reddit and Threads data, page extraction, people search and company search for AI agents.",
  "license": "MIT",
  "homepage": "https://github.com/Desearch-ai/n8n-nodes-desearch",
  "keywords": [
    "n8n-community-node-package",
    "desearch",
    "search",
    "x-search",
    "web-search",
    "tiktok",
    "facebook",
    "instagram",
    "youtube",
    "reddit",
    "threads",
    "extract",
    "people-search",
    "company-search"
  ],
  "author": {
    "name": "Desearch AI",
    "email": "dev@desearch.ai"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Desearch-ai/n8n-nodes-desearch.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "test": "vitest run",
    "e2e": "npm run build && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/e2e-full-coverage.mts",
    "e2e:yrt": "npm run build && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/e2e-youtube-reddit-threads.mts",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/DesearchApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Desearch/Desearch.node.js",
      "dist/nodes/DesearchPeopleSearch/DesearchPeopleSearch.node.js",
      "dist/nodes/DesearchCompanySearch/DesearchCompanySearch.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^21.1.0",
    "typescript": "5.9.2",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
